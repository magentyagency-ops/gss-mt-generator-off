# ============================================================================
# .env.example — copier en .env et adapter. NE PAS committer .env (cf. .gitignore)
# ============================================================================

# --- Corpus (chemins locaux, hors dépôt git) ---------------------------------
# Par défaut, relatifs à la racine du workspace (parent de gss-ao/).
CORPUS_DCE_DIR=../Cas-Univ-Rouen-MP2026-08
CORPUS_SLIDE_REP_AO_DIR=../SLIDE REP AO

# --- Conversion .doc legacy --------------------------------------------------
# Laisser vide pour auto-détection (PATH + /Applications/LibreOffice.app).
SOFFICE_BIN=

# --- OCR (fallback optionnel, désactivé par défaut) --------------------------
OCR_ENABLED=false
TESSERACT_BIN=
OCR_LANG=fra

# --- RAG : embeddings --------------------------------------------------------
# Provider : voyage | openai | bge_local | none (dry-run sans calcul réel)
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- RAG : vector store ------------------------------------------------------
# Backend : jsonl (dry-run local) | pgvector
VECTOR_STORE=jsonl
VECTOR_STORE_JSONL_PATH=data/output/slide_rep_ao_chunks.jsonl

# --- PostgreSQL / pgvector (utilisé si VECTOR_STORE=pgvector) ----------------
DATABASE_URL=postgresql+psycopg://gss:gss@localhost:5432/gss_ao

# --- LLM (non appelé en itération 1) -----------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL_LONG=claude-sonnet-4-6
LLM_MODEL_UTILITY=claude-haiku-4-5-20251001

# --- Stockage objets (S3/MinIO — Module A, non implémenté) -------------------
S3_ENDPOINT_URL=
S3_BUCKET=gss-ao

# --- Supabase (backend) ------------------------------------------------------
# À copier depuis Dashboard → Project Settings → API.
# On n'utilise QUE l'anon key : la sécurité repose sur la RLS.
SUPABASE_URL=https://TON-PROJET.supabase.co
SUPABASE_ANON_KEY=

# --- Ticket #4 : Recherche web (Perplexity) ---------------------------------
# Clé API Perplexity (modèle sonar). NE PAS committer de valeur ici.
PERPLEXITY_API_KEY=
# Clé service_role Supabase — insertion de la traçabilité (table recherche_web)
# par le backend de confiance. Laisser vide en template.
SUPABASE_SERVICE_ROLE_KEY=

# --- Refonte du mémoire technique (octobre 2026) : réglages et retour arrière --
# Toutes ces variables sont FACULTATIVES : laissées vides, le comportement de la refonte s'applique.
# GSS_MEMOIRE_TYPE      : réponse libre construite sur le mémoire type (défaut : oui) ; « non » = rédaction v1
# GSS_THEME             : style des mémoires et schémas (défaut : marine) ; « gss-2026-09 » = ancien thème
# GSS_IA_MODELE         : modèle OpenAI de rédaction (défaut : gpt-6-luna)
# GSS_IA_EFFORT         : effort de raisonnement de tous les usages (défaut : effort par usage)
# GSS_IA_EFFORT_REDACTION : effort de la rédaction (défaut : low)
# GSS_IA_CACHE          : « implicite » = cache de prompt implicite (défaut : explicite sur GPT-5.6 et suivants)
# GSS_IA_SERVICE_TIER   : niveau de service (défaut : flex pour gpt-6-luna) ; « standard » pour le désactiver
# Retour complet à l'état d'avant la refonte :
#   GSS_IA_MODELE=gpt-5.6-luna GSS_IA_EFFORT=medium GSS_IA_CACHE=implicite GSS_THEME=gss-2026-09 GSS_MEMOIRE_TYPE=non
# GSS_MEMOIRE_TYPE=
# GSS_THEME=
# GSS_IA_MODELE=
# GSS_IA_EFFORT=
# GSS_IA_EFFORT_REDACTION=
# GSS_IA_CACHE=
# GSS_IA_SERVICE_TIER=

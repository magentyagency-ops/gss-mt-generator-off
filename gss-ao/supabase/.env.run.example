# ============================================================================
# Ticket #3 — Secrets du RUN réel (déploiement + tests) — TEMPLATE
# Copier en .env.run.local (gitignoré) et remplir. NE JAMAIS committer les valeurs.
# Les commandes du run sourcent .env.run.local.
# ============================================================================

# --- Accès CLI Supabase (non-interactif) ------------------------------------
# Token perso : https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Référence du projet de Clarence (dashboard → Project Settings → General)
SUPABASE_PROJECT_REF=
# Mot de passe base (dashboard → Project Settings → Database)
SUPABASE_DB_PASSWORD=

# --- Clé publique (aussi mise dans frontend/.env.local) ---------------------
SUPABASE_ANON_KEY=

# --- Secrets des Edge Functions (supabase secrets set) ----------------------
INBOUND_EMAIL_DOMAIN=            # ex. ao.gss-domaine.fr
INBOUND_WEBHOOK_SECRET=          # ex. openssl rand -hex 24
EMAIL_PROVIDER=                  # 'postmark' pour envoi réel ; vide = DRY-RUN
EMAIL_FROM=                      # ex. GSS AO <ao@ao.gss-domaine.fr>
POSTMARK_SERVER_TOKEN=           # si EMAIL_PROVIDER=postmark

# NB : SUPABASE_SERVICE_ROLE_KEY n'est PAS requis ici — Supabase l'injecte
#      automatiquement dans les Edge Functions déployées (utilisé par inbound-email).

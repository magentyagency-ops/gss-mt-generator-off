# ============================================================================
# .gitignore — racine du workspace (= dépôt git réel)
# ============================================================================
# La logique RGPD / confidentialité est documentée dans gss-ao/DECISIONS.md.
#
# Principe : les pièces de marché public (RC, CCAP, CCTP, BPU/DPGF, mémoire
# technique) ne sont pas confidentielles en soi et peuvent rester versionnées.
# En revanche, tout ce qui contient des DONNÉES PERSONNELLES (annexes agents)
# ou du CONTENU INTERNE GSS (base de connaissances, audit métier) est exclu.
# ============================================================================

# --- RGPD & Données Confidentielles -----------------------------------------

# Annexe 2 = profils agents en place, Annexe 4 = agents logés,
# Annexe 5 = correspondants sûreté locaux -> données nominatives.
Cas-Univ-Rouen-MP2026-08/Annexes/

# Base de connaissances interne GSS (Dossier + lien symbolique)
SLIDE REP AO
SLIDE REP AO/

# Transcription de l'audit métier
audit/

# ============================================================================
# Artefacts techniques & Environnement
# ============================================================================

# Système
.DS_Store

# Variables d'environnement
.env
.env.local
.env.*.local


# Node / Next.js
node_modules/
.next/
out/
npm-debug.log*

# ============================================================================
# Fichiers générés et Dossiers de travail
# ============================================================================

# Sorties générées par l'outil (parsing, ingestion RAG)
gss-ao/data/output/
gss-ao/data/*.jsonl
*.local.json

# Dossiers de travail (Réponses et dossiers projets)
réponse/
response/
dossiers/

# --- Sorties générées par l'app (NE PAS versionner) -------------------------
# Mémoires/DOCX/PDF produits par le générateur, JSON de dossier, previews.
dossier-*.json
Mémoire technique GSS*.docx
Mémoire technique GSS*.pdf
data/output/
data/output/*.docx
data/output/*.pdf
data/output/*.md
*.tmp
dist/

# TypeScript incremental build cache
*.tsbuildinfo

.vscode/
